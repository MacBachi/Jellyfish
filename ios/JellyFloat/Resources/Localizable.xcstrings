{
  "sourceLanguage": "en",
  "strings": {
    " Newer modes fall back to another mode on older jellies; nothing is blocked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Neuere Modi fallen auf älteren Quallen auf einen anderen Modus zurück; nichts wird blockiert."
          }
        }
      }
    },
    " One jelly is newer than this app; it may have modes the app cannot show.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Eine Qualle ist neuer als diese App; sie hat vielleicht Modi, die die App nicht zeigen kann."
          }
        }
      }
    },
    " and %lld more": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " und %lld weitere"
